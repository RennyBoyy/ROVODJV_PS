# Unity YAML merge for text-based assets
*.unity   merge=unityyamlmerge eol=lf
*.prefab  merge=unityyamlmerge eol=lf

# Treat .asset as binary, track via LFS, and prevent text merges
*.asset   filter=lfs diff=lfs merge=lfs -text

# Lock large binary assets (including terrain) to avoid conflicts
*.asset   lockable
*.fbx     lockable
*.png     lockable
*.wav     lockable

# Ensure meta files stay as LF-terminated text
*.asset.meta   text eol=lf
*.unity.meta   text eol=lf
*.prefab.meta  text eol=lf